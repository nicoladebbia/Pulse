<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pulse.embedding-backfill</string>

    <!-- Repairs the embedding gap the daily run leaves behind when a Voyage batch fails.
         Coverage had decayed 100% (Mar 2026) -> 49.7% (Aug 2026) = 15,839 stories absent
         from vector search, because a failed batch was logged and dropped forever
         (embeddings.rs) and this repair mode existed but was NEVER SCHEDULED. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/nicoladebbia/Projects/Pulse/target/release/pulse-fetcher</string>
        <string>--mode</string>
        <string>backfill-embeddings</string>
        <string>--max-minutes</string>
        <string>90</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/nicoladebbia</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>

    <!-- 02:00 and 14:00. Two safeguards make a long-running backfill harmless:
         (1) it takes the SAME flock as the daily fetch, so the two can never overlap;
         (2) it exits immediately unless today's briefing already has news — once that is
             true every hourly daily slot skips in <1s anyway, so holding the lock is free.
         Without (2) a 90-minute backfill could block the exact hourly slot that catches a
         clean Groq window on a blocked day. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/nicoladebbia/Projects/Pulse</string>

    <key>StandardOutPath</key>
    <string>/Users/nicoladebbia/Library/Logs/Pulse/embedding-backfill.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/nicoladebbia/Library/Logs/Pulse/embedding-backfill-err.log</string>

    <key>KeepAlive</key>
    <false/>

    <key>ThrottleInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <false/>

    <!-- Backfill is strictly lower priority than the briefing: never let it compete for
         I/O or CPU with a daily fetch that happens to start right as it finishes. -->
    <key>Nice</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
