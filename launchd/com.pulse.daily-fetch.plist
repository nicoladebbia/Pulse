<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pulse.daily-fetch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/nicoladebbia/Projects/Pulse/target/release/pulse-fetcher</string>
        <string>--mode</string>
        <string>daily</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/nicoladebbia</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <!-- Cost A/B: Llama-4 Scout for PRE_CURATE only (~3.3x cheaper, simple
             index-list output it handles fine). analyze is pinned to 70B in code
             (client.rs) regardless of this var — scout failed the large analyze
             payload twice on 2026-06-25 (json_validate + serde type mismatch).
             Scout is a Groq Preview model — if deprecated, remove this key and
             pre_curate falls back to llama-3.3-70b (the code default). -->
        <key>PULSE_STRONG_MODEL</key>
        <string>meta-llama/llama-4-scout-17b-16e-instruct</string>
    </dict>

    <!-- 4 fixed slots: 7am, 12pm, 6pm, 10pm. Groq blocks the VPN/school source IP
         intermittently (per-exit-server), so a single fixed time misses most days.
         Each run does a cheap preflight probe (client.rs::groq_reachable) and exits
         in <2s if blocked, so 4 slots is nearly free and catches whatever reachable
         window opens. The news-based skip check (main.rs) makes extra slots no-ops
         once the day already has news. See .plans/groq-vpn-block-plan.md. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>7</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>12</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>18</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>22</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/nicoladebbia/Projects/Pulse</string>

    <key>StandardOutPath</key>
    <string>/Users/nicoladebbia/Library/Logs/Pulse/fetch-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/nicoladebbia/Library/Logs/Pulse/fetch-stderr.log</string>

    <key>KeepAlive</key>
    <false/>

    <key>ThrottleInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
