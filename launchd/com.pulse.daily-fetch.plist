<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pulse.daily-fetch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/nicoladebbia/Projects/Pulse/target/release/pulse-fetcher</string>
        <string>--mode</string>
        <string>daily</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/nicoladebbia</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <!-- PULSE_STRONG_MODEL removed 2026-08-06: Groq decommissioned Llama-4
             Scout (~2026-07-17), so the override 404'd and daily pre_curate fell
             back to the dumb sector cap for 3 weeks. pre_curate now uses the code
             default llama-3.3-70b. -->
    </dict>

    <!-- Hourly, on the hour. Groq blocks the VPN/school source IP intermittently
         (per-exit-server), so the only thing that reliably catches a clean window is
         sampling more often. The 4-slot version (7am/12pm/6pm/10pm) missed every
         window for 4 days straight (2026-08-10→14: 96h with no briefing, every slot
         logging "Groq unreachable"), while a manual probe at 19:18 got HTTP 200 —
         i.e. reachable windows existed between the slots.

         A slot that can't work costs ~2s: the preflight probe
         (client.rs::groq_reachable) exits early when blocked, and the news-based skip
         check (main.rs) makes extra slots no-ops once the day already has news. A slot
         that fires while a fetch is still running exits in <1s on the single-instance
         flock (main.rs::acquire_single_instance_lock) without touching the DB or the
         progress file. See .plans/groq-vpn-block-plan.md. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/nicoladebbia/Projects/Pulse</string>

    <key>StandardOutPath</key>
    <string>/Users/nicoladebbia/Library/Logs/Pulse/fetch-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/nicoladebbia/Library/Logs/Pulse/fetch-stderr.log</string>

    <key>KeepAlive</key>
    <false/>

    <key>ThrottleInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
