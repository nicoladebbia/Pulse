ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...
GROQ_API_KEY=...

# Or run everything on local models instead (no keys needed): see scripts/setup-local-ai.sh
# PULSE_LLM=local
# ...but keep the slowest step (per-story summaries) on Groq for speed:
# PULSE_CLOUD_TASKS=summarize

# Contact details for two sources that ask who is reading. Left out, the
# requests still go out, without a contact. Reddit answered those with a 404
# on 2026-11-17, so set PULSE_REDDIT_USER if you want Reddit posts.
# PULSE_CONTACT_EMAIL=you@example.com   # arXiv (research reader)
# PULSE_REDDIT_USER=your_reddit_name    # Reddit's public feeds

# Alpaca PAPER account (alpaca.markets > Paper > API Keys): trades, portfolio,
# quotes and the live price stream. Finnhub is optional once these are set.
# ALPACA_API_KEY=PK...
# ALPACA_SECRET_KEY=...
# AUTO_TRADE_ENABLED=true   # buy on convergence signals (paper)
# EXIT_DRY_RUN=false        # actually sell on stops/targets (paper)
